out = ARGV.len() > 0 ? ARGV[0] : "build/mug.dslb";
p = _dsl_ schema="../schema/lmcad.dsl.json";
scene.background(0.10, 0.13, 0.18);
let ceramic = material().color(0.22, 0.62, 0.78).roughness(0.35).specular(0.82).shininess(16.0);
let handle_material = material().color(0.14, 0.42, 0.56).roughness(0.42);
let profile = scene.sketch();
profile.point(0.0, -7.0).point(4.0, -7.0).point(4.8, -6.2).point(5.0, 4.5).point(4.6, 7.0).point(0.0, 7.0).close();
let mug = scene.revolve_y(profile, ceramic).name("ceramic mug");
mug.hollow_top(0.8);
mug.fillet(0.32);
let handle_profile = scene.sketch();
for (i in range(0, 25)) {
  let angle = -1.57079632679 + float(i) * 3.14159265359 / 24.0;
  handle_profile.point(4.4 + 4.6 * cos(angle), 4.6 * sin(angle));
}
for (i in range(0, 25)) {
  let angle = 1.57079632679 - float(i) * 3.14159265359 / 24.0;
  handle_profile.point(4.4 + 3.7 * cos(angle), 3.7 * sin(angle));
}
handle_profile.close();
let handle = scene.extrude(handle_profile, 0.9, handle_material).position(0.0, 0.0, -0.45);
mug.union(handle);
handle.visible(false);
scene.assert_close(mug.volume(), 356.65346483485348, 0.000001);
scene.fit_camera(38.0, 1.2);
scene.directional_light(-0.35, -1.0, -0.25, 0.92);
scene.fill_light(0.8, -0.2, 0.9, 0.22);
scene.ambient(0.22);
scene.render_png("build/mug.png", 540, 405);
scene.export_stl("build/mug.stl");
end _dsl_
savedsl(p, out);
println(f"wrote {out}");
