# One primitive, a numeric volume assertion, and a small PNG render.
out = ARGV.len() > 0 ? ARGV[0] : "build/box-volume.dslb";
p = _dsl_ schema="../schema/lmcad.dsl.json";
let shape = scene.box(2.0, 3.0, 4.0, material().color(0.2, 0.55, 0.85));
scene.assert_close(shape.volume(), 24.0, 0.000001);
scene.fit_camera(42.0, 1.2);
scene.directional_light(-0.5, -1.0, -0.4, 0.8);
scene.ambient(0.2);
scene.render_png("build/box-volume.png", 320, 240);
end _dsl_
savedsl(p, out);
println(f"wrote {out}");
