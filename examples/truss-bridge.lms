# Pratt truss footbridge: method of joints, solved in closed form.
# Span 24 m in six 4 m panels, depth 4 m, 100 kN on each of the five deck
# joints. Support reactions R = 250 kN; the textbook answer for the middle top
# chord is -450 kN (compression) and the centre vertical carries nothing.
# 1. lmcad builds both trusses with scene.tube_between: red members are in
#    tension, blue in compression, grey carry zero; tube radius grows with |F|.
# 2. lmplot draws the 2D elevation with every member force labelled.
# Writes images/truss-bridge.png (900x760).
out = ARGV.len() > 0 ? ARGV[0] : "build/truss-bridge.dslb";
mkdir("images");
mkdir("build");

cad = _dsl_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
scene.background(1.0, 1.0, 1.0);
scene.supersample(3);
scene.ambient(0.30);
scene.directional_light(-0.35, -0.85, -0.45, 0.95);
scene.fill_light(0.60, 0.20, 0.70, 0.45);
let steel = material().color(0.30, 0.33, 0.38).specular(0.4).shininess(30.0);
let deck_mat = material().color(0.74, 0.72, 0.68).roughness(0.8);

let n = 6;
let d = 4.0;
let h = 4.0;
let load = 100.0;
let reaction = float(n - 1) * load / 2.0;
let diag = sqrt(d * d + h * h);
let sin_t = h / diag;
let fmax = 450.0;

for (side in range(0, 2)) {
  let z = -2.6 + 5.2 * float(side);
  # joints
  for (i in range(0, n + 1)) {
    scene.sphere(0.30, steel).position(float(i) * d, 0.0, z);
    if (i > 0) {
      if (i < n) { scene.sphere(0.30, steel).position(float(i) * d, h, z); }
    }
  }
  # bottom chord panels k = 0..n-1 (tension M/h)
  for (k in range(0, n)) {
    let kk = k;
    if (k >= n / 2) { kk = n - 1 - k; }
    let j = max(kk, 1);
    let m = reaction * float(j) * d - load * d * float(j * (j - 1)) / 2.0;
    let f = m / h;
    let t = abs(f) / fmax;
    scene.tube_between(float(k) * d, 0.0, z, float(k + 1) * d, 0.0, z, 0.10 + 0.16 * t, material().color(lerp(0.62, 0.86, t), lerp(0.62, 0.18, t), lerp(0.64, 0.14, t)).specular(0.3));
  }
  # top chord panels k = 1..n-2 (compression -M/h)
  for (k in range(1, n - 1)) {
    let kk = k;
    if (k >= n / 2) { kk = n - 1 - k; }
    let j = kk + 1;
    let m = reaction * float(j) * d - load * d * float(j * (j - 1)) / 2.0;
    let f = 0.0 - m / h;
    if (kk == n / 2 - 1) { scene.assert_close(f, -450.0, 0.000001); }
    let t = abs(f) / fmax;
    scene.tube_between(float(k) * d, h, z, float(k + 1) * d, h, z, 0.10 + 0.16 * t, material().color(lerp(0.62, 0.14, t), lerp(0.62, 0.36, t), lerp(0.64, 0.86, t)).specular(0.3));
  }
  # inclined end posts (compression R / sin)
  let fe = reaction / sin_t;
  let te = fe / fmax;
  let post = material().color(lerp(0.62, 0.14, te), lerp(0.62, 0.36, te), lerp(0.64, 0.86, te)).specular(0.3);
  scene.tube_between(0.0, 0.0, z, d, h, z, 0.10 + 0.16 * te, post);
  scene.tube_between(float(n) * d, 0.0, z, float(n - 1) * d, h, z, 0.10 + 0.16 * te, post);
  # diagonals slope down toward mid-span (tension shear / sin)
  for (k in range(1, n / 2)) {
    let f = (reaction - float(k) * load) / sin_t;
    let t = f / fmax;
    let mat = material().color(lerp(0.62, 0.86, t), lerp(0.62, 0.18, t), lerp(0.64, 0.14, t)).specular(0.3);
    scene.tube_between(float(k) * d, h, z, float(k + 1) * d, 0.0, z, 0.10 + 0.16 * t, mat);
    scene.tube_between(float(n - k) * d, h, z, float(n - k - 1) * d, 0.0, z, 0.10 + 0.16 * t, mat);
  }
  # verticals: hip hanger +P, then -(R - iP), centre vertical zero
  for (i in range(1, n)) {
    let ii = i;
    if (i > n / 2) { ii = n - i; }
    let f = 0.0;
    if (ii == 1) { f = load; }
    if (ii > 1) {
      if (ii < n / 2) { f = 0.0 - (reaction - float(ii) * load); }
    }
    let t = abs(f) / fmax;
    let mat = material().color(0.62, 0.62, 0.64).specular(0.3);
    if (f > 0.0) { mat = material().color(lerp(0.62, 0.86, t), lerp(0.62, 0.18, t), lerp(0.64, 0.14, t)).specular(0.3); }
    if (f < 0.0) { mat = material().color(lerp(0.62, 0.14, t), lerp(0.62, 0.36, t), lerp(0.64, 0.86, t)).specular(0.3); }
    scene.tube_between(float(i) * d, 0.0, z, float(i) * d, h, z, 0.10 + 0.16 * t, mat);
  }
}
# floor beams, top struts and deck slab
for (i in range(0, n + 1)) {
  scene.tube_between(float(i) * d, -0.05, -2.6, float(i) * d, -0.05, 2.6, 0.12, steel);
  if (i > 0) {
    if (i < n) { scene.tube_between(float(i) * d, h, -2.6, float(i) * d, h, 2.6, 0.09, steel); }
  }
}
scene.box(float(n) * d + 1.2, 0.22, 4.6, deck_mat).position(float(n) * d / 2.0, -0.30, 0.0);
scene.camera(28.0, 1.0, 9.5, 27.0, 12.0, 1.3, 0.0);
scene.render_ppm("build/truss-bridge-3d.ppm", 900, 400);
end _dsl_
savedsl(cad, "build/truss-bridge-3d.dslb");
r = system ${dsl_cli(cad)} --dsl build/truss-bridge-3d.dslb;
assert(r.code == 0);

p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
# Same closed-form method of joints: rows are x1 y1 x2 y2 force(kN).
let n = 6;
let d = 4.0;
let h = 4.0;
let load = 100.0;
let reaction = float(n - 1) * load / 2.0;
let sin_t = h / sqrt(d * d + h * h);
let rows = "";
for (k in range(0, n)) {
  let kk = k;
  if (k >= n / 2) { kk = n - 1 - k; }
  let j = max(kk, 1);
  let f = (reaction * float(j) * d - load * d * float(j * (j - 1)) / 2.0) / h;
  rows = rows + str(float(k) * d) + " 0 " + str(float(k + 1) * d) + " 0 " + str(f) + "\n";
}
for (k in range(1, n - 1)) {
  let kk = k;
  if (k >= n / 2) { kk = n - 1 - k; }
  let j = kk + 1;
  let f = 0.0 - (reaction * float(j) * d - load * d * float(j * (j - 1)) / 2.0) / h;
  rows = rows + str(float(k) * d) + " " + str(h) + " " + str(float(k + 1) * d) + " " + str(h) + " " + str(f) + "\n";
}
let fe = 0.0 - reaction / sin_t;
rows = rows + "0 0 " + str(d) + " " + str(h) + " " + str(fe) + "\n";
rows = rows + str(float(n) * d) + " 0 " + str(float(n - 1) * d) + " " + str(h) + " " + str(fe) + "\n";
for (k in range(1, n / 2)) {
  let f = (reaction - float(k) * load) / sin_t;
  rows = rows + str(float(k) * d) + " " + str(h) + " " + str(float(k + 1) * d) + " 0 " + str(f) + "\n";
  rows = rows + str(float(n - k) * d) + " " + str(h) + " " + str(float(n - k - 1) * d) + " 0 " + str(f) + "\n";
}
for (i in range(1, n)) {
  let ii = i;
  if (i > n / 2) { ii = n - i; }
  let f = 0.0;
  if (ii == 1) { f = load; }
  if (ii > 1) {
    if (ii < n / 2) { f = 0.0 - (reaction - float(ii) * load); }
  }
  rows = rows + str(float(i) * d) + " 0 " + str(float(i) * d) + " " + str(h) + " " + str(f) + "\n";
}
plot.data("TRUSS", rows);

plot.png("images/truss-bridge.png", 900, 760);
plot.cmd("set encoding utf8");
plot.cmd("set multiplot");
# top: lmcad render
plot.script("set origin 0.0, 0.47\nset size 1.0, 0.53");
plot.script("set lmargin 0\nset rmargin 0\nset tmargin 2.2\nset bmargin 0");
plot.cmd("set title 'Pratt truss footbridge — 100 kN at each deck joint (lmcad render, tube radius ∝ |F|)' font ',12'");
plot.cmd("set xrange [0:899]");
plot.cmd("set yrange [0:399]");
plot.cmd("set size ratio -1");
plot.cmd("unset tics");
plot.cmd("unset border");
plot.cmd("unset key");
plot.cmd("plot 'build/truss-bridge-3d.ppm' binary array=(900,400) skip=15 flipy format='%uchar' using 1:2:3 with rgbimage");
# bottom: 2D elevation with member forces
plot.cmd("set size noratio");
plot.script("set origin 0.0, 0.0\nset size 1.0, 0.49");
plot.script("set lmargin 3\nset rmargin 12\nset tmargin 2.0\nset bmargin 1.5");
plot.cmd("set title 'Method of joints: member force (kN), + tension / − compression' font ',11'");
plot.cmd("set xrange [-1.5:25.5]");
plot.cmd("set yrange [-2.4:5.3]");
plot.cmd("set cbrange [-450:450]");
plot.cmd("set palette defined (-450 '#1e4fd6', 0 '#b8bcc4', 450 '#d6281e')");
plot.cmd("set colorbox vertical user origin 0.905, 0.07 size 0.018, 0.33");
plot.cmd("set cbtics 150 font ',9'");
plot.cmd("set cblabel 'F (kN)' font ',9'");
plot.cmd("set label 1 'R = 250 kN' at 0, -1.75 center font ',10' tc rgb '#334155'");
plot.cmd("set label 2 'R = 250 kN' at 24, -1.75 center font ',10' tc rgb '#334155'");
plot.cmd("set label 3 '100 kN at each deck joint' at 12, -1.9 center font ',10' tc rgb '#b45309'");
plot.cmd("set style fill solid 1.0");
for (i in range(1, n)) {
  plot.cmd("set arrow " + str(10 + i) + " from " + str(float(i) * d) + ", -0.25 to " + str(float(i) * d) + ", -1.35 head filled size 0.35,25 lw 2 lc rgb '#d97706'");
}
plot.cmd("set arrow 20 from 0, -1.35 to 0, -0.3 head filled size 0.35,25 lw 2 lc rgb '#334155'");
plot.cmd("set arrow 21 from 24, -1.35 to 24, -0.3 head filled size 0.35,25 lw 2 lc rgb '#334155'");
plot.cmd("plot $TRUSS using 1:2:($3-$1):($4-$2):5 with vectors nohead lw 6 lc palette, $TRUSS using 1:2 with points pt 7 ps 1.4 lc rgb '#1f2937', $TRUSS using (($1+$3)/2):(($2+$4)/2):($5 == 0 ? '0' : sprintf('%+.0f', $5)) with labels boxed font ',9' tc rgb '#0f172a'");
plot.cmd("unset multiplot");
plot.close();
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);
println("wrote images/truss-bridge.png");
