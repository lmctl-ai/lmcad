# Same steel, different shape: why bridges use I-beams.
# Four beam sections share one cross-section area A = 3200 mm^2 (so the same
# mass per metre): a solid square, a solid round bar, a square tube and an
# I-beam. Bending stiffness depends on the second moment of area I, which
# grows with the square of the distance of material from the neutral axis.
# Under a 10 kN mid-span load on a 3 m simply supported span (E = 200 GPa)
# the deflection d = P L^3 / (48 E I) drops from 33 mm (square) to 1.3 mm
# (I-beam): 25 times stiffer for the same steel.
# 1. lmcad extrudes the four sections and checks that each 400 mm piece has
#    the same B-rep volume, A * 400 mm^3.
# 2. lmplot compares I and deflection.
# Writes images/beam-sections.png (900x700).
out = ARGV.len() > 0 ? ARGV[0] : "build/beam-sections.dslb";
mkdir("images");
mkdir("build");

cad = _dsl_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
let area = 3200.0;
let len = 400.0;
let pi = 3.14159265358979;
scene.background(1.0, 1.0, 1.0);
scene.supersample(3);
scene.ambient(0.26);
scene.directional_light(-0.45, -0.70, -0.55, 1.0);
scene.fill_light(0.80, -0.20, 0.30, 0.35);
let c_sq = material().color(0.58, 0.62, 0.68).specular(0.45).shininess(36.0);
let c_rd = material().color(0.46, 0.60, 0.74).specular(0.45).shininess(36.0);
let c_tb = material().color(0.30, 0.52, 0.80).specular(0.45).shininess(36.0);
let c_ib = material().color(0.86, 0.36, 0.18).specular(0.45).shininess(36.0);

# solid square
let a = sqrt(area);
let sq = scene.box(a, a, len, c_sq).position(-280.0, a / 2.0, 0.0);
scene.assert_close(sq.volume(), area * len, 0.001);
# solid round (cylinder axis is y; turn it onto z)
let r = sqrt(area / pi);
let rd = scene.cylinder(r, len, c_rd).rotate(pi / 2.0, 0.0, 0.0).translate(-160.0, r, 0.0);
scene.assert_close(rd.volume(), area * len, 0.5);
# square tube, 120 mm outside
let bo = 120.0;
let bi = sqrt(bo * bo - area);
let tube = scene.box(bo, bo, len, c_tb).position(0.0, bo / 2.0, 0.0);
let core = scene.box(bi, bi, len + 20.0, c_tb).position(0.0, bo / 2.0, 0.0);
tube.cut(core);
core.visible(false);
scene.assert_close(tube.volume(), area * len, 0.01);
# I-beam: 200 deep, 100 wide flanges 10 thick, web sized to make up the area
let hh = 200.0;
let bf = 100.0;
let tf = 10.0;
let tw = (area - 2.0 * bf * tf) / (hh - 2.0 * tf);
let ib = scene.sketch();
ib.point(0.0 - bf / 2.0, 0.0).point(bf / 2.0, 0.0).point(bf / 2.0, tf).point(tw / 2.0, tf);
ib.point(tw / 2.0, hh - tf).point(bf / 2.0, hh - tf).point(bf / 2.0, hh).point(0.0 - bf / 2.0, hh);
ib.point(0.0 - bf / 2.0, hh - tf).point(0.0 - tw / 2.0, hh - tf).point(0.0 - tw / 2.0, tf).point(0.0 - bf / 2.0, tf);
ib.close();
let beam = scene.extrude(ib, len, c_ib).translate(175.0, 0.0, 0.0 - len / 2.0);
scene.assert_close(beam.volume(), area * len, 0.01);
scene.box(620.0, 6.0, 470.0, material().color(0.86, 0.88, 0.90).roughness(0.9)).position(-40.0, -3.0, 0.0);
scene.camera(30.0, 60.0, 420.0, 860.0, -40.0, 50.0, 0.0);
scene.render_ppm("build/beam-sections-3d.ppm", 900, 380);
end _dsl_
savedsl(cad, "build/beam-sections-3d.dslb");
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(cad), ["--dsl", "build/beam-sections-3d.dslb"]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);

p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
let area = 3200.0;
let pi = 3.14159265358979;
let load = 10000.0;
let span = 3000.0;
let e = 200000.0;
let a = sqrt(area);
let i_sq = a * a * a * a / 12.0;
let i_rd = area * area / (4.0 * pi);
let bo = 120.0;
let bi = sqrt(bo * bo - area);
let i_tb = (pow(bo, 4.0) - pow(bi, 4.0)) / 12.0;
let tw = (area - 2.0 * 100.0 * 10.0) / (200.0 - 20.0);
let i_ib = (100.0 * pow(200.0, 3.0) - (100.0 - tw) * pow(180.0, 3.0)) / 12.0;
let k = load * span * span * span / (48.0 * e);
let rows = "0 Solid_square " + str(i_sq / 1000000.0) + " " + str(k / i_sq) + " 9741240\n";
rows = rows + "1 Round_bar " + str(i_rd / 1000000.0) + " " + str(k / i_rd) + " 7705532\n";
rows = rows + "2 Square_tube " + str(i_tb / 1000000.0) + " " + str(k / i_tb) + " 5080524\n";
rows = rows + "3 I-beam " + str(i_ib / 1000000.0) + " " + str(k / i_ib) + " 14375982\n";
plot.data("SEC", rows);
plot.echo("I-beam / square stiffness ratio: " + str(i_ib / i_sq));

plot.png("images/beam-sections.png", 900, 700);
plot.cmd("set encoding utf8");
plot.cmd("set multiplot");
plot.script("set origin 0.0, 0.44\nset size 1.0, 0.56");
plot.script("set lmargin 0\nset rmargin 0\nset tmargin 2.4\nset bmargin 0");
plot.cmd("set title 'Four steel beams with the same area A = 3200 mm² (same weight per metre)' font ',12'");
plot.cmd("set xrange [0:899]");
plot.cmd("set yrange [0:379]");
plot.cmd("set size ratio -1");
plot.cmd("unset tics");
plot.cmd("unset border");
plot.cmd("unset key");
plot.cmd("plot 'build/beam-sections-3d.ppm' binary array=(900,380) skip=15 flipy format='%uchar' using 1:2:3 with rgbimage");
plot.cmd("set size noratio");
plot.script("set origin 0.0, 0.0\nset size 1.0, 0.46");
plot.script("set lmargin 10\nset rmargin 3\nset tmargin 2.2\nset bmargin 2.5");
plot.cmd("set title 'Mid-span deflection under 10 kN on a 3 m span (δ = PL³ / 48EI)' font ',11'");
plot.cmd("set border 3 lw 1.2 lc rgb '#334155'");
plot.cmd("set xrange [-0.6:3.6]");
plot.cmd("set yrange [0:42]");
plot.cmd("set ytics 0, 10, 40 nomirror font ',10'");
plot.cmd("set xtics nomirror font ',11'");
plot.cmd("set ylabel 'Deflection δ (mm)' font ',11'");
plot.cmd("set grid ytics lc rgb '#e2e8f0'");
plot.cmd("set style fill solid 0.95 noborder");
plot.cmd("set label 1 '" + plot.str("sprintf('%.0f× stiffer than the solid square,\nsame weight', " + str(i_ib / i_sq) + ")") + "' at 3.0, 16 center font ',10.5' tc rgb '#b45309'");
plot.cmd("set boxwidth 0.62");
plot.cmd("plot $SEC using 1:4:5:xtic(strcol(2)[1:strstrt(strcol(2).'_','_')-1].(strstrt(strcol(2),'_') ? ' '.strcol(2)[strstrt(strcol(2),'_')+1:] : '')) with boxes lc rgb variable, $SEC using 1:4:(sprintf('δ = %.1f mm\nI = %.2f×10⁶ mm⁴', $4, $3)) with labels offset 0,1.6 font ',10' tc rgb '#0f172a' noenhanced");
plot.cmd("unset multiplot");
plot.close();
end _dsl_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--dsl", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/beam-sections.png");
