# Range loop: seven identical cubes placed along x by one for-loop.
out = ARGV.len() > 0 ? ARGV[0] : "build/loop-row.dslb";
mkdir("images");
mkdir("build");
p = _dsl_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
let mat = material().color(0.18, 0.62, 0.88);
for (i in range(0, 7)) {
  let x = float(i) - 3.0;
  scene.box(0.7, 0.7, 0.7, mat).position(x, 0.0, 0.0);
}
scene.camera(32.0, 0.0, 3.0, 7.6, 0.0, 0.0, 0.0);
scene.directional_light(-0.4, -1.0, -0.5, 0.72);
scene.fill_light(0.8, -0.2, 0.9, 0.42);
scene.ambient(0.24);
scene.background(0.04, 0.06, 0.1);
scene.render_png("images/loop-row.png", 480, 270);
end _dsl_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--dsl", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/loop-row.png");
