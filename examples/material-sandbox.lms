# A 3x3 grid of spheres: rows are three base colours, columns go from matte to glossy. Ported from lmmagnum/lmfilament examples/material-sandbox.lms.
out = ARGV.len() > 0 ? ARGV[0] : "build/material-sandbox.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
scene.background(0.08, 0.09, 0.12);
scene.sphere(0.8, material().color(0.85, 0.25, 0.2).roughness(0.9).specular(0.05).shininess(8.0)).position(-2.0, 2.0, 0.0);
scene.sphere(0.8, material().color(0.85, 0.25, 0.2).roughness(0.5).specular(0.4).shininess(32.0)).position(0.0, 2.0, 0.0);
scene.sphere(0.8, material().color(0.85, 0.25, 0.2).roughness(0.1).specular(0.9).shininess(96.0)).position(2.0, 2.0, 0.0);
scene.sphere(0.8, material().color(0.25, 0.75, 0.3).roughness(0.9).specular(0.05).shininess(8.0)).position(-2.0, 0.0, 0.0);
scene.sphere(0.8, material().color(0.25, 0.75, 0.3).roughness(0.5).specular(0.4).shininess(32.0)).position(0.0, 0.0, 0.0);
scene.sphere(0.8, material().color(0.25, 0.75, 0.3).roughness(0.1).specular(0.9).shininess(96.0)).position(2.0, 0.0, 0.0);
scene.sphere(0.8, material().color(0.25, 0.4, 0.9).roughness(0.9).specular(0.05).shininess(8.0)).position(-2.0, -2.0, 0.0);
scene.sphere(0.8, material().color(0.25, 0.4, 0.9).roughness(0.5).specular(0.4).shininess(32.0)).position(0.0, -2.0, 0.0);
scene.sphere(0.8, material().color(0.25, 0.4, 0.9).roughness(0.1).specular(0.9).shininess(96.0)).position(2.0, -2.0, 0.0);
scene.supersample(3);
scene.ambient(0.18);
scene.directional_light(-0.5, -0.7, -0.7, 1.0);
scene.fill_light(0.8, -0.2, 0.9, 0.2);
scene.camera(30.0, 0.0, 0.0, 14.0, 0.0, 0.0, 0.0);
scene.render_png("images/material-sandbox.png", 640, 640);
end _lmcode_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--lmcode", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote images/material-sandbox.png");
