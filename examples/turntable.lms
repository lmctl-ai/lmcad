# Camera turntable: one solid, 36 frames orbiting at 10 degrees per frame,
# written as a looping APNG by the host (and converted to GIF with ffmpeg).
out = ARGV.len() > 0 ? ARGV[0] : "build/turntable.dslb";
mkdir("images");
mkdir("build");
p = _dsl_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
scene.background(0.055, 0.065, 0.09);
let bronze = material().color(0.72, 0.38, 0.14).roughness(0.4);
let body = scene.box(8.0, 2.4, 6.0, bronze);
let crown = scene.sphere(2.1, bronze).position(0.0, 2.7, 0.0);
body.union(crown);
crown.visible(false);
scene.directional_light(-0.7, -1.0, -0.5, 0.72);
scene.fill_light(0.8, -0.2, 0.9, 0.42);
scene.ambient(0.24);
let camera = scene.camera(40.0, 0.0, 5.0, 16.0, 0.0, 0.0, 0.0);
let movie = scene.animation("build/turntable.apng", 160, 120, 24);
for (frame in range(0, 36)) {
  let angle = float(frame) * 6.28318530718 / 36.0;
  camera.look_at(16.0 * cos(angle), 7.0, 16.0 * sin(angle), 0.0, 0.0, 0.0);
  movie.add_frame();
}
movie.finish();
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);
println("wrote build/turntable.apng");
g = system ffmpeg -y -loglevel error -i build/turntable.apng -vf "split[a][b];[a]palettegen=max_colors=64[p];[b][p]paletteuse=dither=none" -loop 0 images/turntable.gif;
if (g.code == 0) {
  println("wrote images/turntable.gif");
} else {
  println("ffmpeg not available: skipped images/turntable.gif (build/turntable.apng is the animation)");
}
