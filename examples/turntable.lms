out = ARGV.len() > 0 ? ARGV[0] : "build/turntable.dslb";
p = _dsl_ schema="../schema/lmcad.dsl.json";
scene.background(0.055, 0.065, 0.09);
let bronze = material().color(0.72, 0.38, 0.14).roughness(0.4);
let body = scene.box(8.0, 2.4, 6.0, bronze);
let crown = scene.sphere(2.1, bronze).position(0.0, 2.7, 0.0);
body.union(crown);
crown.visible(false);
scene.directional_light(-0.7, -1.0, -0.5, 0.72);
scene.fill_light(0.8, -0.2, 0.9, 0.42);
scene.ambient(0.24);
let camera = scene.camera(40.0, 0.0, 5.0, 16.0, 0.0, 0.0, 0.0);
let movie = scene.animation("build/turntable.apng", 160, 120, 24);
for (frame in range(0, 36)) {
  let angle = float(frame) * 6.28318530718 / 36.0;
  camera.look_at(16.0 * cos(angle), 7.0, 16.0 * sin(angle), 0.0, 0.0, 0.0);
  movie.add_frame();
}
movie.finish();
end _dsl_
savedsl(p, out);
println(f"wrote {out}");
