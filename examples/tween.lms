# Keyframe tween: a sphere eases between two CSV keyframes in position and
# colour; 30 numbered PNG frames plus a looping APNG.
out = ARGV.len() > 0 ? ARGV[0] : "build/tween.dslb";
mkdir("build");
# Two keyframes (time, position, colour); the host reads them as CSV.
write_file("build/keyframes.csv", "t,x,y,z,r,g,b\n0.0,-1.5,0.0,0.0,0.95,0.18,0.12\n1.0,1.5,0.7,0.0,0.12,0.55,0.95\n");
p = _lmcode_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
let keys = read_keyframes_csv("build/keyframes.csv");
let mat = material().specular(0.4).shininess(56.0);
let shape = scene.sphere(1.15, mat);
scene.camera(38.0, 0.0, 2.8, 8.0, 0.0, 0.0, 0.0);
scene.directional_light(-0.35, -1.0, -0.25, 0.92);
scene.fill_light(0.8, -0.2, 0.9, 0.22);
scene.ambient(0.16);
scene.background(0.16, 0.20, 0.27);
scene.supersample(2);
let movie = scene.animation("build/tween.apng", 320, 240, 30);
let frames_per_segment = 30;
for (segment in range(0, keys.len() - 1)) {
  let a = keys.at(segment);
  let b = keys.at(segment + 1);
  let first_step = 0;
  if (segment > 0) { first_step = 1; }
  for (step in range(first_step, frames_per_segment)) {
    let t = float(step) / float(frames_per_segment - 1);
    let e = ease(t);
    let x = lerp(a.x(), b.x(), e);
    let y = lerp(a.y(), b.y(), e);
    let z = lerp(a.z(), b.z(), e);
    let r = lerp(a.r(), b.r(), e);
    let g = lerp(a.g(), b.g(), e);
    let blue = lerp(a.b(), b.b(), e);
    shape.position(x, y, z).color(r, g, blue);
    let frame_index = segment * (frames_per_segment - 1) + step;
    scene.render_png("build/tween-" + str(frame_index) + ".png", 320, 240);
    movie.add_frame();
  }
}
movie.finish();
end _lmcode_
savedsl(p, out);
# run the bytecode with the host it was compiled against (10 min limit; system() defaults to 60 s)
r = system(concat(dsl_cli(p), ["--dsl", out]), 600000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("wrote build/tween.apng and build/tween-0.png .. build/tween-29.png");
