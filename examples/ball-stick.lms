// A compact water molecule: endpoint tubes make the bond geometry independent
// of the coordinate system, which also suits trajectory segments.
let oxygen = material().color(0.88, 0.08, 0.06).roughness(0.38).specular(0.35);
let hydrogen = material().color(0.86, 0.90, 0.96).roughness(0.42).specular(0.25);
let bond = material().color(0.48, 0.52, 0.60).roughness(0.60);

scene.sphere(0.72, oxygen).position(0.0, 0.0, 0.0);
scene.sphere(0.42, hydrogen).position(-1.05, 0.0, 0.72);
scene.sphere(0.42, hydrogen).position(1.05, 0.0, 0.72);
scene.tube_between(0.0, 0.0, 0.0, -1.05, 0.0, 0.72, 0.16, bond);
scene.tube_between(0.0, 0.0, 0.0, 1.05, 0.0, 0.72, 0.16, bond);
scene.fit_camera(38.0, 1.25);
scene.directional_light(-0.6, -1.0, -0.5, 0.85);
scene.fill_light(0.8, -0.2, 0.8, 0.25);
scene.background(0.035, 0.045, 0.07);
scene.render_png("build/ball-stick.png", 640, 480);
