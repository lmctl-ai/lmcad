out = ARGV.len() > 0 ? ARGV[0] : "build/vase.dslb";
p = _dsl_ schema="../schema/lmcad.dsl.json";
scene.background(0.16, 0.20, 0.27);
let ceramic = material().color(0.48, 0.70, 0.82).roughness(0.30).specular(0.70).shininess(28.0);
let profile = scene.sketch();
profile.point(0.0, 0.0).point(5.0, 0.0).point(6.5, 2.0);
for (i in range(1, 13)) {
  let t = float(i) / 12.0;
  let u = 1.0 - t;
  let x = u * u * u * 6.5 + 3.0 * u * u * t * 7.5 + 3.0 * u * t * t * 10.0 + t * t * t * 10.0;
  let y = u * u * u * 2.0 + 3.0 * u * u * t * 4.0 + 3.0 * u * t * t * 22.0 + t * t * t * 30.0;
  profile.point(x, y);
}
profile.point(0.0, 30.0).close();
let vase = scene.revolve_y(profile, ceramic).name("turned vase");
vase.hollow_top(1.1);
scene.assert_close(vase.volume(), 1708.2677036376435, 0.000001);
scene.fit_camera(38.0, 1.2);
scene.directional_light(-0.25, -1.0, -0.45, 1.0);
scene.fill_light(0.8, -0.2, 0.9, 0.18);
scene.ambient(0.18);
scene.render_png("build/vase.png", 560, 420);
scene.export_stl("build/vase.stl");
end _dsl_
savedsl(p, out);
println(f"wrote {out}");
