out = ARGV.len() > 0 ? ARGV[0] : "build/vase.dslb";
p = _dsl_ schema="../schema/lmcad.dsl.json";
scene.background(0.10, 0.13, 0.18);
let ceramic = material().color(0.22, 0.54, 0.72).roughness(0.36);
let profile = scene.sketch();
profile.point(0.0, 0.0).point(5.0, 0.0).point(6.5, 2.0).point(8.0, 9.0);
profile.point(9.0, 18.0).point(10.0, 26.0).point(10.0, 30.0).point(0.0, 30.0).close();
let vase = scene.revolve_y(profile, ceramic).name("turned vase");
vase.hollow_top(1.1);
scene.assert_close(vase.volume(), 1735.8527040063793, 0.000001);
scene.fit_camera(38.0, 1.2);
scene.directional_light(-0.6, -1.0, -0.8, 0.72);
scene.fill_light(0.8, -0.2, 0.9, 0.42);
scene.ambient(0.24);
scene.render_png("build/vase.png", 720, 540);
scene.export_stl("build/vase.stl");
end _dsl_
savedsl(p, out);
println(f"wrote {out}");
