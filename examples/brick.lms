out = ARGV.len() > 0 ? ARGV[0] : "build/brick.dslb";
p = _dsl_ schema="../schema/lmcad.dsl.json";
scene.background(0.16, 0.20, 0.27);
let red = material().color(0.78, 0.13, 0.07).roughness(0.38).specular(0.22).shininess(28.0);
let stud_red = material().color(0.98, 0.27, 0.14).roughness(0.28).specular(0.72).shininess(16.0);
let brick = scene.box(48.0, 9.6, 16.0, red).name("brick");
for (ix in range(0, 6)) {
  for (iz in range(0, 2)) {
    let x = -20.0 + float(ix) * 8.0;
    let z = -4.0 + float(iz) * 8.0;
    let stud = scene.cylinder(2.4, 1.8, stud_red).position(x, 5.7, z);
    brick.union(stud);
    stud.visible(false);
  }
}
brick.hollow(1.2);
scene.assert_close(brick.volume(), 2422.39883791502, 0.000001);
scene.fit_camera(38.0, 1.2);
scene.directional_light(-0.25, -1.0, -0.45, 1.0);
scene.fill_light(0.8, -0.2, 0.9, 0.12);
scene.ambient(0.12);
scene.render_png("build/brick.png", 720, 540);
scene.export_stl("build/brick.stl");
end _dsl_
savedsl(p, out);
println(f"wrote {out}");
