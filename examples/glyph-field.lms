out = ARGV.len() > 0 ? ARGV[0] : "build/glyph-field.dslb";
p = _dsl_ schema="../schema/lmcad.dsl.json";
scene.background(0.035, 0.045, 0.075);
scene.ambient(0.32);
scene.supersample(2);
let key = scene.directional_light(-0.7, -1.0, -0.6, 0.85);
scene.fill_light(0.8, -0.2, 0.9, 0.45);
for (ix in range(0, 5)) {
  for (iz in range(0, 5)) {
    let t = float(ix * 5 + iz) / 24.0;
    let red = lerp(0.12, 0.96, t);
    let green = lerp(0.30, 0.28, t);
    let blue = lerp(0.92, 0.12, t);
    let x = float(ix) * 1.45 - 2.9;
    let z = float(iz) * 1.45 - 2.9;
    let ball = scene.sphere(0.52, material());
    ball.position(x, 0.0, z).color(red, green, blue);
  }
}
scene.fit_camera(38.0, 1.22);
scene.render_png("build/glyph-field.png", 720, 540);
scene.export_stl("build/glyph-field.stl");
end _dsl_
savedsl(p, out);
println(f"wrote {out}");
