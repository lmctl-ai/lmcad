out = ARGV.len() > 0 ? ARGV[0] : "build/readme-architecture.dslb";
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(840, 370, "#101a25");
scene.text(34.0, 51.0, 29.0, "From parametric source to useful geometry", "#f3f7fa").set_attr("font-weight", "700");
scene.rect(24.0, 132.0, 180.0, 148.0, "#233b50");
scene.rect(230.0, 132.0, 180.0, 148.0, "#254c53");
scene.rect(436.0, 132.0, 180.0, 148.0, "#34445b");
scene.rect(642.0, 132.0, 180.0, 148.0, "#55472d");
scene.circle(60.0, 166.0, 12.0, "#f1bb65");
scene.path("M 252.0 154.0 L 276.0 166.0 L 252.0 178.0 Z", "#68c9b5", "none", 1.0);
scene.rect(458.0, 154.0, 38.0, 24.0, "#8bb5de");
scene.rect(664.0, 154.0, 38.0, 24.0, "#e7a853");
scene.text(114.0, 232.0, 26.0, "LMScript", "#f4f6f8").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(320.0, 232.0, 26.0, "Schema", "#f4f6f8").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(526.0, 232.0, 23.0, "OCCT + mesh", "#f4f6f8").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(732.0, 232.0, 26.0, "PNG / STL", "#f4f6f8").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
let arrow0 = scene.line(206.0, 204.0, 225.0, 204.0, "#f1bb65", 2.8);
arrow0.set_attr("marker-end", "arrow");
let arrow1 = scene.line(412.0, 204.0, 431.0, 204.0, "#f1bb65", 2.8);
arrow1.set_attr("marker-end", "arrow");
let arrow2 = scene.line(618.0, 204.0, 637.0, 204.0, "#f1bb65", 2.8);
arrow2.set_attr("marker-end", "arrow");
scene.render_png("build/rendered/readme-architecture.png", 840, 370, 1);
end _dsl_
savedsl(p, out);
