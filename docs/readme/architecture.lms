out = ARGV.len() > 0 ? ARGV[0] : "build/readme-architecture.dslb";
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1080, 340, "#101a25");
scene.text(48.0, 53.0, 25.0, "From parametric source to useful geometry", "#f3f7fa").set_attr("font-weight", "700");
scene.text(48.0, 81.0, 15.0, "A declared schema connects the script to lmcad's native solid-modeling host.", "#a9bac8");
scene.rect(48.0, 132.0, 214.0, 134.0, "#233b50");
scene.rect(304.0, 132.0, 214.0, 134.0, "#254c53");
scene.rect(560.0, 132.0, 214.0, 134.0, "#34445b");
scene.rect(816.0, 132.0, 214.0, 134.0, "#55472d");
scene.circle(84.0, 169.0, 13.0, "#f1bb65");
scene.path("M 340.0 156.0 L 367.0 169.0 L 340.0 182.0 Z", "#68c9b5", "none", 1.0);
scene.rect(596.0, 156.0, 42.0, 26.0, "#8bb5de");
scene.rect(852.0, 156.0, 42.0, 26.0, "#e7a853");
scene.text(155.0, 218.0, 19.0, "LMScript", "#f4f6f8").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(411.0, 218.0, 18.0, "lmcad schema", "#f4f6f8").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(667.0, 218.0, 18.0, "OCCT + mesh", "#f4f6f8").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(923.0, 218.0, 19.0, "PNG / STL", "#f4f6f8").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(155.0, 246.0, 13.0, "design + assertions", "#bdcbd5").set_attr("text-anchor", "middle");
scene.text(411.0, 246.0, 13.0, "typed host API", "#bdcbd5").set_attr("text-anchor", "middle");
scene.text(667.0, 246.0, 13.0, "solids to triangles", "#bdcbd5").set_attr("text-anchor", "middle");
scene.text(923.0, 246.0, 13.0, "render or export", "#bdcbd5").set_attr("text-anchor", "middle");
let arrow0 = scene.line(268.0, 199.0, 292.0, 199.0, "#f1bb65", 2.4);
arrow0.set_attr("marker-end", "arrow");
let arrow1 = scene.line(524.0, 199.0, 548.0, 199.0, "#f1bb65", 2.4);
arrow1.set_attr("marker-end", "arrow");
let arrow2 = scene.line(780.0, 199.0, 804.0, 199.0, "#f1bb65", 2.4);
arrow2.set_attr("marker-end", "arrow");
scene.render_png("build/rendered/readme-architecture.png", 1080, 340, 1);
end _dsl_
savedsl(p, out);
