out = ARGV.len() > 0 ? ARGV[0] : "build/readme-hero-dark.dslb";
p = _dsl_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
scene.background(0.035, 0.07, 0.11);
let plate_material = material().color(0.48, 0.72, 0.82).roughness(0.32).specular(0.7).shininess(36.0);
let plate = scene.box(12.0, 1.0, 8.0, plate_material).name("mounting plate");
for (ix in range(0, 4)) {
  for (iz in range(0, 2)) {
    let x = -4.5 + float(ix) * 3.0;
    let z = -2.0 + float(iz) * 4.0;
    let bore = scene.cylinder(0.72, 2.0, plate_material).position(x, 0.0, z);
    plate.cut(bore);
    bore.visible(false);
    let counterbore = scene.cylinder(0.91, 0.2, plate_material).position(x, 0.45, z);
    plate.cut(counterbore);
    counterbore.visible(false);
  }
}
scene.camera(32.0, 15.0, 12.0, 18.0, 0.0, 0.0, 0.0);
scene.directional_light(-0.3, -1.0, -0.45, 1.0);
scene.fill_light(0.8, -0.2, 0.9, 0.24);
scene.ambient(0.14);
scene.supersample(2);
scene.render_png("build/rendered/readme-hero-dark.png", 1100, 620);
end _dsl_
savedsl(p, out);
